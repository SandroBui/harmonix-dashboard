NEXT_PUBLIC_SAFE_ADDRESS=
# Server-only — optional for HyperEVM (public tx-service). Forwarded as Bearer when set.
SAFE_API_KEY=

# Server-only — Harmonix decode API origin (no trailing slash). Unset → Safe/local fallback.
TRANSACTION_DECODE_API_BASE_URL=

# Server-only — Etherscan API v2 key (chainId 999 / HyperEVM) for v2 action history
HYPEREVMSCAN_API_KEY=

# Set to true to enable Google OAuth authentication guard
GOOGLE_AUTH=false

# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Public URL of this app (OAuth callback / CSRF). Local: http://localhost:3000
AUTH_URL=http://localhost:3000

# Google OAuth — same client as the backend (GOOGLE_CLIENT_ID audience)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only origin of rock-onyx-api (no trailing slash). Used to exchange
# Google id_token via POST {API_BASE_URL}/api/v1/admin/auth/google
API_BASE_URL=http://localhost:8001
